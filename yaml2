# =========================
# 核心配置
# =========================
mixed-port: 7893
mode: rule
allow-lan: true
tcp-concurrent: true
unified-delay: true
log-level: info
ipv6: true

tun:
  enable: true
  stack: system
  auto-route: true
  auto-redirect: true
  strict-route: true
  dns-hijack: [0.0.0.0:53]
  endpoint-independent-nat: true

sniffer:
  enable: true
  override-destination: true
  sniff:
    TLS: {ports: [443, 8443]}
    HTTP: {ports: [80, 8080-8880], override-destination: true}
    QUIC: {ports: [443]}

dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  prefer-h3: true
  default-nameserver: [114.114.114.114, 223.5.5.5]
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - '*.lan'
    - 'rule-set:cn_domain'
    - 'msftconnecttest.com'
    - 'connectivitycheck.platform.hicloud.com'


# 七一 Clashmi 全优化配置 (支持 Gemini)
# Seven1_Clashmi_Full_Optimized
mixed-port: 7893
mode: rule
allow-lan: true
tcp-concurrent: true
unified-delay: true
log-level: info
ipv6: true

tun:
  enable: true
  stack: system
  auto-route: true
  auto-redirect: true
  strict-route: true
  dns-hijack: [0.0.0.0:53]
  endpoint-independent-nat: true

sniffer:
  enable: true
  override-destination: true
  sniff:
    TLS: {ports: [443, 8443]}
    HTTP: {ports: [80, 8080-8880], override-destination: true}
    QUIC: {ports: [443]}

dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  prefer-h3: true
  default-nameserver: [114.114.114.114, 223.5.5.5]
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - '*.lan'
    - 'rule-set:cn_domain'
    - 'msftconnecttest.com'
    - 'connectivitycheck.platform.hicloud.com'
    - 'gemini.com'   # ✅ 确保 Gemini 不被 fake-ip 干扰

proxy-groups:
  - {name: 一键代理, type: select, proxies: [香港故转, 台湾故转, 日本故转, 韩国故转, 新加坡故转, 美国故转, 欧洲故转, 香港自动, 台湾自动, 日本自动, 韩国自动, 新加坡自动, 美国自动, 欧洲自动, 香港手动, 台湾手动, 日本手动, 韩国手动, 新加坡手动, 美国手动, 欧洲手动, 其他手动, DIRECT, REJECT]}
  - {name: 广告拦截, type: select, proxies: [REJECT, DIRECT]}
  # 原有其他代理策略保持不变...

rules:
  - DOMAIN-SUFFIX,gemini.com,一键代理   # ✅ Gemini 优先走代理
  - RULE-SET,ads_domain,广告拦截
  - RULE-SET,private_ip,DIRECT,no-resolve
  - RULE-SET,private_domain,DIRECT
  - RULE-SET,ai,ChatGPT
  - RULE-SET,github_domain,GitHub
  - RULE-SET,youtube_domain,YouTube
  - RULE-SET,google_domain,Google
  - RULE-SET,telegram_domain,Telegram
  - RULE-SET,twitter_domain,Twitter
  - RULE-SET,tiktok_domain,TikTok
  - RULE-SET,netflix_domain,Netflix
  - RULE-SET,disney_domain,Disney
  - RULE-SET,spotify_domain,Spotify
  - RULE-SET,microsoft_domain,Microsoft
  - RULE-SET,apple_domain,Apple
  - RULE-SET,paypal_domain,PayPal
  - RULE-SET,speedtest_domain,Speedtest
  - RULE-SET,geolocation-!cn,一键代理
  - RULE-SET,cn_domain,DIRECT
  - RULE-SET,cn_ip,DIRECT,no-resolve
  - MATCH,漏网之鱼


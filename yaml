# Seven1_Clashmi_Full_Optimized (Android 完整版)
mixed-port: 7893
mode: rule
allow-lan: true
tcp-concurrent: true
unified-delay: true
log-level: info
ipv6: true

tun:
  enable: true
  stack: system
  auto-route: true
  auto-redirect: true
  strict-route: true
  dns-hijack: [0.0.0.0:53]
  endpoint-independent-nat: true

sniffer:
  enable: true
  override-destination: true
  sniff:
    TLS: {ports: [443, 8443]}
    HTTP: {ports: [80, 8080-8880], override-destination: true}
    QUIC: {ports: [443]}

dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  prefer-h3: true
  default-nameserver: [114.114.114.114, 223.5.5.5]
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - '*.lan'
    - 'rule-set:cn_domain'
    - 'msftconnecttest.com'
    - 'connectivitycheck.platform.hicloud.com'
    - 'gemini.com'

proxy-groups:
  - {name: 一键代理, type: select, proxies: [香港故转, 台湾故转, 日本故转, 韩国故转, 新加坡故转, 美国故转, 欧洲故转, 香港自动, 台湾自动, 日本自动, 韩国自动, 新加坡自动, 美国自动, 欧洲自动, 香港手动, 台湾手动, 日本手动, 韩国手动, 新加坡手动, 美国手动, 欧洲手动, 其他手动, DIRECT, REJECT]}
  - {name: 广告拦截, type: select, proxies: [REJECT, DIRECT]}
  - {name: YouTube, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Google, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: ChatGPT, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: GitHub, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Telegram, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Twitter, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: TikTok, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Netflix, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Disney, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Spotify, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Microsoft, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Apple, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: PayPal, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: Speedtest, type: select, proxies: [一键代理, DIRECT, REJECT]}
  - {name: 漏网之鱼, type: select, proxies: [一键代理, DIRECT, REJECT]}

# 各区域节点策略保持不变（示例）
  - {name: 香港故转, type: fallback, proxies: [香港手动, 香港自动], url: 'https://www.g.cn/generate_204', interval: 300, timeout: 2000, max-failed-times: 3, hidden: true}
  - {name: 香港手动, type: select, proxies: [香港手动节点1, 香港手动节点2]}
  - {name: 香港自动, type: url-test, proxies: [香港手动节点1, 香港手动节点2], url: 'https://www.g.cn/generate_204', interval: 300, timeout: 2000, tolerance: 50, include-all: true}
# 其他地区同理：台湾、日本、韩国、新加坡、美国、欧洲、其他手动

rules:
  - DOMAIN-SUFFIX,gemini.com,一键代理
  - RULE-SET,ads_domain,广告拦截
  - RULE-SET,private_ip,DIRECT,no-resolve

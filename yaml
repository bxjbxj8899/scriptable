# ※※※※※※※※※※※※※※※ 核心配置 ※※※※※※※※※※※※※※※
mixed-port: 7893
mode: rule
allow-lan: true
tcp-concurrent: true
unified-delay: true
log-level: info
ipv6: true

# 手机端 TUN 优化
tun:
  enable: true
  stack: system                                                         # 手机端建议使用 system 栈，兼容性最强
  mtu: 1500
  dns-hijack: [0.0.0.0:53]
  auto-route: true
  auto-redirect: true
  strict-route: true
  endpoint-independent-nat: true

# 嗅探设置
sniffer:
  enable: true
  override-destination: true
  parse-pure-ip: true
  force-dns-mapping: true
  sniff:
    QUIC: {ports: [443]}
    TLS: {ports: [443, 8443]}
    HTTP: {ports: [80, 8080-8880], override-destination: true}

# DNS 性能优化版
dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  respect-rules: true                                                   # 核心改动：使DNS解析遵循分流规则，防止泄露
  prefer-h3: true                                                       # 开启 HTTP/3 解析，提速明显
  default-nameserver: [114.114.114.114, 223.5.5.5]
  proxy-server-nameserver: [https://dns.alidns.com/dns-query]           # 代理服务器域名由国内解析，防止连不上节点
  nameserver:
    - https://doh.pub/dns-query#h3=true
    - https://dns.alidns.com/dns-query#h3=true
  fake-ip-filter:
    - '*.lan'
    - 'rule-set:cn_domain'
    - 'msftconnecttest.com'                                             # 解决 Android 网络检查
    - 'connectivitycheck.platform.hicloud.com'                          # 华为网络检查

